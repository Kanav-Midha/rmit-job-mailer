# Copy to .env and fill in. .env is gitignored - never commit real values.

# --- Where to send the digest ----------------------------------------------
# Your own address goes in .env, NOT here. Keeping it out of .env.example
# stops it being scraped from the public repo.
MAIL_TO=you@example.com
MAIL_FROM=you@example.com

# --- Sending over Gmail SMTP ------------------------------------------------
# Gmail no longer accepts your normal password. You need an App Password:
#   1. Turn on 2-Step Verification: https://myaccount.google.com/security
#   2. Create an app password:      https://myaccount.google.com/apppasswords
#   3. Paste the 16 characters below, spaces removed.
# Revoke it from the same page at any time.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@example.com
SMTP_PASSWORD=

# --- Gmail ingestion (Career Centre alert emails) ---------------------------
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json
GMAIL_QUERY=from:(careercentre.me) newer_than:7d
GMAIL_MAX_RESULTS=50

# --- RMIT Careers (Workday) -------------------------------------------------
ENABLE_WORKDAY=true
WORKDAY_SEARCH_TEXT=
# Seconds between requests. Do not lower this.
WORKDAY_DELAY_SECONDS=2.0
WORKDAY_MAX_PAGES=5

# --- Company job boards (Greenhouse) -----------------------------------------
# RMIT Careers only lists RMIT's own vacancies. Graduate software roles come from
# company boards. Greenhouse publishes every board as a public JSON API, no key
# needed: https://boards-api.greenhouse.io/v1/boards/<token>/jobs
#
# To find a token, open a company's careers page. If the URL is
# boards.greenhouse.io/cultureamp or job-boards.greenhouse.io/cultureamp then the
# token is "cultureamp". Companies not on Greenhouse return 404 and are skipped.
ENABLE_GREENHOUSE=true
GREENHOUSE_BOARDS=cultureamp
# Seconds between boards. Be polite; these are free public endpoints.
GREENHOUSE_DELAY_SECONDS=1.0

# --- Behaviour --------------------------------------------------------------
# 0 means email every new posting. Raise it to filter (e.g. 40).
NOTIFY_MIN_SCORE=0
# Safety valve so a parser bug cannot send you a 500-job email.
NOTIFY_MAX_PER_RUN=60
DATABASE_URL=sqlite:///tracker.db
LOG_LEVEL=INFO
