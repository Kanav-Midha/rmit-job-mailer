# Copy to .env and fill in. .env is gitignored - never commit real values.
#
# The scheduled GitHub Actions run does NOT read this file. Anything the schedule
# depends on has to be stated in .github/workflows/poll.yml as well.

# --- Where to send the digest ----------------------------------------------
# Your own address goes in .env, NOT here. Keeping it out of .env.example
# stops it being scraped from the public repo.
MAIL_TO=you@example.com
MAIL_FROM=you@example.com

# --- Sending over Gmail SMTP ------------------------------------------------
# Gmail no longer accepts your normal password. You need an App Password:
#   1. Turn on 2-Step Verification: https://myaccount.google.com/security
#   2. Create an app password:      https://myaccount.google.com/apppasswords
#   3. Paste the 16 characters below, spaces removed.
# Revoke it from the same page at any time.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@example.com
SMTP_PASSWORD=

# --- Gmail ingestion (Career Centre alert emails) ---------------------------
# Off by default. What actually arrives from the Career Centre is a Canvas
# announcement linking to a list, not the postings themselves, so this source
# costs an OAuth setup and returns nothing. See docs/adr/0002.
ENABLE_GMAIL=false
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json
GMAIL_QUERY=from:(careercentre.me) newer_than:7d
GMAIL_MAX_RESULTS=50

# --- RMIT Careers (Workday) -------------------------------------------------
ENABLE_WORKDAY=true
WORKDAY_SEARCH_TEXT=
# Seconds between requests. Do not lower this.
WORKDAY_DELAY_SECONDS=2.0
# 20 postings per page. RMIT advertises about 50 at a time across all campuses.
WORKDAY_MAX_PAGES=10
# Workday's Country facet. RMIT advertises its Melbourne and Vietnam campuses in
# one feed and the Vietnam roles outnumber the Australian ones roughly three to
# one, so this is the difference between a useful digest and a useless one.
# Leave blank to fetch every country.
#   Australia  d903bb3fedad45039383f6de334ad4db
#   Vietnam    db69e8c8446c11de98360015c5e6daf6
WORKDAY_COUNTRY_FACET=d903bb3fedad45039383f6de334ad4db
# Fewest postings a healthy run should collect. RMIT always has a dozen or so
# Australian roles live, so zero means robots.txt refused, the endpoint moved or
# the request was blocked - not a quiet day. Below this the run fails loudly
# instead of sending nothing and looking fine. 0 turns the check off.
WORKDAY_MIN_EXPECTED=1

# --- Company job boards (Greenhouse) -----------------------------------------
# RMIT Careers only lists RMIT's own vacancies. Graduate software roles come from
# company boards. Greenhouse publishes every board as a public JSON API, no key
# needed: https://boards-api.greenhouse.io/v1/boards/<token>/jobs
#
# To find a token, open a company's careers page. If the URL is
# boards.greenhouse.io/cultureamp or job-boards.greenhouse.io/cultureamp then the
# token is "cultureamp". Companies not on Greenhouse return 404 and are skipped.
ENABLE_GREENHOUSE=true
GREENHOUSE_BOARDS=cultureamp
# Seconds between boards. Be polite; these are free public endpoints.
GREENHOUSE_DELAY_SECONDS=1.0

# --- Behaviour --------------------------------------------------------------
# 0 means email every new posting. Raise it to filter (e.g. 40).
NOTIFY_MIN_SCORE=0
# Only email these categories, comma separated. Empty means all of them.
# "campus" is the RMIT roles a current student can actually apply for:
# library, ambassador, peer advisor, casual tutoring, orientation.
NOTIFY_CATEGORIES=
# Safety valve so a parser bug cannot send you a 500-job email.
NOTIFY_MAX_PER_RUN=60

# SQLite is right for local runs. The scheduled run needs Postgres, because a
# GitHub runner is destroyed after each job and would take the file with it:
#   DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Paste a hosted URL exactly as the provider gives it; the driver is sorted out
# in db.py.
DATABASE_URL=sqlite:///tracker.db
LOG_LEVEL=INFO
